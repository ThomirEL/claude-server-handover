# Example <launch dir>/.handover.env — plain shell KEY='value' lines.
# The launch dir is the folder holding this file: Claude starts there on the server.

# git repo to mirror with its .git (branches travel). Relative to launch dir or absolute.
HANDOVER_REPO='.'

# extra dirs/files to mirror, space-separated, must live under $HOME.
# Mac is canonical on push, server is canonical on pull.
HANDOVER_SYNC_PATHS='~/repos/myproj-data'

# irreplaceable files: backed up before overwrite, never overwrite a NEWER copy
# in either direction (HANDOVER_FORCE=1 overrides).
HANDOVER_GUARDED_FILES='~/.myproj/state.db'

# tmux session name (default: launch dir basename). Auto-suffixed -2, -3 if taken.
HANDOVER_SESSION='myproj'

# shell run inside the remote repo before Claude starts (idempotent!)
HANDOVER_REMOTE_SETUP='[ -d .venv ] || python3 -m venv .venv; ./.venv/bin/pip install -q -e ".[dev]"'

# env exported into the remote Claude session; ~ in values -> server home
HANDOVER_REMOTE_ENV='MYPROJ_DB=~/.myproj/state.db'

# extra rsync excludes (node_modules .venv __pycache__ .pytest_cache already skipped)
HANDOVER_EXCLUDES='dist .cache'
